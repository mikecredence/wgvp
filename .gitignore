# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
wgvp-env/

# Pipeline outputs (never commit a run) - except the operator pick shipped with the second sample
wgvp_output/
!sample_v2/data/wgvp_output/
sample_v2/data/wgvp_output/*
!sample_v2/data/wgvp_output/HC901/
sample_v2/data/wgvp_output/HC901/*
!sample_v2/data/wgvp_output/HC901/config/
wgvp_dryrun_*/
# the bundled example ships its deliverables (lifted on our GPU box), so the demo and the tests run without a lift
!examples/bundled/wgvp_output/
examples/bundled/wgvp_output/*
!examples/bundled/wgvp_output/OWN01/
examples/bundled/wgvp_output/OWN01/*
!examples/bundled/wgvp_output/OWN01/deliver/
!examples/bundled/wgvp_output/OWN02/
examples/bundled/wgvp_output/OWN02/*
!examples/bundled/wgvp_output/OWN02/deliver/

# Example corpus: videos and derived files are fetched locally, only the manifest is tracked
examples/data/
examples/_cache/

# GVHMR checkouts / weights are never part of this repo
weights/gvhmr_checkpoints/
GVHMR/

# OS / editors
.DS_Store
Thumbs.db
.idea/
