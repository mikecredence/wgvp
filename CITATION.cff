    given-names: Mike
    email: mcaiola@credence-llc.com
    affiliation: Credence Management Solutions, LLC
version: 0.1.0
date-released: 2026-11-02
repository-code: "https://github.com/mikecredence/wgvp"
license: AGPL-3.0-or-later
keywords:
  - gait analysis
  - pose estimation
  - SMPL
  - GVHMR
  - inertial measurement unit
  - video synchronisation
